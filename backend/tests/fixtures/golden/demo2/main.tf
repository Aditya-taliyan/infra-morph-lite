# Generated by InfraMorph. Do not edit by hand.

locals {
  # EXAMPLE AMI IDs: replace with a current Ubuntu 22.04 AMI before any real deployment, or set var.ubuntu_ami_overrides.
  example_ubuntu_ami_ids = {
    "ap-south-1" = "ami-0fedcba9876543210"
    "us-east-1"  = "ami-0123456789abcdef0"
  }
  ubuntu_ami_ids = merge(local.example_ubuntu_ami_ids, var.ubuntu_ami_overrides)
}

resource "aws_vpc" "main_vpc" {
  cidr_block           = "10.10.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "main-vpc"
    Project     = "inframorph-demo"
  }
}

resource "aws_subnet" "main_vpc_public_a" {
  vpc_id                  = aws_vpc.main_vpc.id
  cidr_block              = "10.10.1.0/24"
  map_public_ip_on_launch = false

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "main-vpc-public-a"
    Project     = "inframorph-demo"
  }
}

resource "aws_internet_gateway" "main_vpc" {
  vpc_id = aws_vpc.main_vpc.id

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "main-vpc-igw"
    Project     = "inframorph-demo"
  }
}

resource "aws_route_table" "main_vpc_public" {
  vpc_id = aws_vpc.main_vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main_vpc.id
  }

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "main-vpc-public"
    Project     = "inframorph-demo"
  }
}

resource "aws_route_table_association" "main_vpc_public_a" {
  subnet_id      = aws_subnet.main_vpc_public_a.id
  route_table_id = aws_route_table.main_vpc_public.id
}

resource "aws_security_group" "web_sg" {
  name        = "web-sg"
  description = "Security group web-sg (managed by InfraMorph)"
  vpc_id      = aws_vpc.main_vpc.id

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "web-sg"
    Project     = "inframorph-demo"
  }
}

resource "aws_vpc_security_group_ingress_rule" "web_sg_ingress_1" {
  security_group_id = aws_security_group.web_sg.id
  ip_protocol       = "tcp"
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 80
  to_port           = 80

  tags = {
    Environment = "dev"
    ManagedBy   = "inframorph"
    Name        = "web-sg-ingress-1"
    Project     = "inframorph-demo"
  }
}

